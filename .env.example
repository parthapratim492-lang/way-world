# Copy this file to .env.local and fill in your own values.

# MongoDB Atlas connection string (same as before — new database recommended, e.g. "way")
MONGODB_URI=your_mongodb_atlas_connection_string_here

# Required by NextAuth for signed-in sessions.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_a_random_generated_string

# Local dev value — update to your real domain once deployed (e.g. https://way.onrender.com)
NEXTAUTH_URL=http://localhost:3000

# OPTIONAL — enables AI-powered intent search ("somewhere quiet to work" understood as a
# concept, not just literal words). Without this, search still works via honest keyword
# matching from Phase 3 — it just won't understand meaning, only literal text.
# Get a key at https://console.anthropic.com — this costs a small amount per search
# (fractions of a cent with Haiku), so set a spending limit on your Anthropic account.
ANTHROPIC_API_KEY=

# OPTIONAL — the email address of your own account. Blog posts you write while
# signed in with this email are automatically tagged "WAY Editorial" instead
# of "Explorer Story". This is a plain check, not a real permissions system —
# don't treat it as access control for anything beyond this one label.
ADMIN_EMAIL=
